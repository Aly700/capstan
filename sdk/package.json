{
  "name": "@capstan/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Capstan worker SDK, client, and CLI",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    "./workflow": "./src/workflow/index.ts",
    "./worker": "./src/worker/index.ts",
    "./client": "./src/client/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "bin": { "capstan": "./bin/capstan.mjs" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "cd .. && buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "esbuild": "0.28.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
