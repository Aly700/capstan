# capstan-server
CAPSTAN_ADDR=:7233
CAPSTAN_DATABASE_URL=postgres://capstan:capstan@127.0.0.1:55432/capstan?sslmode=disable
# comma-separated name:sha256hex pairs; create with `capstan-server keygen <name>`
CAPSTAN_API_KEY_HASHES=
CAPSTAN_DAILY_CAP_USD=2.00
CAPSTAN_MIGRATE=true
CAPSTAN_LOG_LEVEL=info
# AgentOps Gate (optional; enables GATE approvals and tool())
CAPSTAN_GATE_URL=
CAPSTAN_GATE_API_KEY=
# workers and the CLI
CAPSTAN_ADDRESS=http://127.0.0.1:7233
CAPSTAN_API_KEY=
ANTHROPIC_API_KEY=
