# Render the captured session at its original speed; this does not rerun the demo.
Output docs/evidence/demo-crash.gif
Require asciinema
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 13
Set Width 1200
Set Height 720
Set Framerate 10
Set TypingSpeed 1ms
Hide
Type "asciinema play --speed 1 docs/evidence/demo-crash.cast"
Enter
Show
Sleep 18s
